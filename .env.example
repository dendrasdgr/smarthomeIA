#Copiar para .env. O script scripts/00-escolher-gpu.sh faz isto e preenche GPU e COMPOSE_FILE.

#--- GPU -------------------------------------------------------------------
#nvidia | amd | none   (escolher com: bash scripts/00-escolher-gpu.sh amd)
GPU=nvidia
#Ficheiros do Compose a usar (o script 00 atualiza esta linha):
#   nvidia: docker-compose.yml:docker-compose.nvidia.yml
#   amd:    docker-compose.yml:docker-compose.amd.yml
#   none:   docker-compose.yml
COMPOSE_FILE=docker-compose.yml:docker-compose.nvidia.yml

#Só AMD: para placas que o Ollama não lista como suportadas, usar o valor de uma
#placa parecida (ex.: 10.3.0 para RX 6600/6700). Deixar comentado se não for preciso.
#HSA_OVERRIDE_GFX_VERSION=10.3.0

# --- Geral -----------------------------------------------------------------
TZ=Atlantic/Madeira

#Confirmar com o comando: id   (normalmente 1000)
PUID=1000
PGID=1000

#Whisper. Para mais precisão experimentar turbo ou large-v3,
#conforme os nomes suportados pela imagem.
#WHISPER_MODEL_GPU só conta com NVIDIA; com AMD ou sem GPU o Whisper usa o CPU.
WHISPER_MODEL_GPU=medium-int8
WHISPER_MODEL_CPU=small-int8
WHISPER_LANG=pt
WHISPER_BEAM=1

#Piper: pt_PT-tugão-medium é português de Portugal
PIPER_VOICE=pt_PT-tugão-medium

#Ollama: modelo a descarregar (ver se há versão mais recente em https://ollama.com/library)
OLLAMA_MODEL=qwen3.5:9b
#127.0.0.1 = só este PC. 0.0.0.0 = toda a rede (sem autenticação!)
OLLAMA_BIND=127.0.0.1

#Destino das cópias de segurança (scripts/backup-casa.sh).
#Ver o nome do disco com: ls /media/$USER
BACKUP_DESTINO=/media/CHANGE_ME/DISCO-BACKUP/casa
